msgstr "застаріле вимірювання"

msgid "Unable to retrieve controller status"
msgstr "Не вдалося отримати стан контролера"

msgid "Unable to change control mode"
msgstr "Не вдалося змінити режим"

msgid "If the command is unconfirmed, check the status and retry."
msgstr "Якщо команда не підтверджена, перевірте стан і повторіть."

msgid "Connection failed. Check the connection and retry."
msgstr "Помилка з’єднання. Перевірте підключення та повторіть."

msgid "Values must be finite numbers."
msgstr "Значення мають бути скінченними числами."

msgid "Fresh sensor readings and an available controller are required."
msgstr "Потрібні свіжі показники датчика та доступний контролер."

msgid "The temperature exceeds the overheat threshold. Wait for cooling."
msgstr "Температура перевищує поріг перегріву. Дочекайтеся охолодження."

msgid "Finish the active brew session first."
msgstr "Спочатку завершіть активну сесію варіння."

msgid "Stop manual temperature control first."
msgstr "Спочатку зупиніть ручне керування температурою."

msgid "Target temperature and warning threshold must be whole numbers."
msgstr "Потрібні цілі значення температури та порогу попередження."

msgid "Brewery deleted successfully."
msgstr "Пивоварню успішно видалено."

msgid "Recipe deleted successfully."
msgstr "Рецепт успішно видалено."

msgid "command_id is required."
msgstr "Потрібно вказати command_id."

msgid "Command is no longer pending."
msgstr "Команда більше не очікує виконання."
